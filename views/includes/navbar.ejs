<style>
  .fa-magnifying-glass{
    display: flex;
    align-items: center;
    gap: 5px;
  }
  .fa-magnifying-glass> p{
    margin-bottom: 0 !important
  }
</style>

<nav class="navbar navbar-expand-md bg-body-tertiary sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand" href="/listings"
      ><i class="fa-brands fa-airbnb"></i
    ></a>
    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNavAltMarkup"
      aria-controls="navbarNavAltMarkup"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>
    <div
      class="collapse navbar-collapse bg-body-tertiary ps-2"
      id="navbarNavAltMarkup"
    >
      <div class="navbar-nav">
        <a class="nav-link" href="/listings">Explore</a>
      </div>
      <form class="d-flex ms-auto" role="search">
        <input
          class="form-control me-2 border-secondary"
          type="search"
          placeholder="Search"
          aria-label="Search"
        />
        <button class="btn btn-danger rounded-pill" type="submit">
          <i class="fa-solid fa-magnifying-glass"><p>Search</p></i>
        </button>
      </form>
      <div class="navbar-nav ms-auto">
        <a class="nav-link" href="/listings/new">Airbnb your home</a>
        <% if (!currUser) { %>
        <a class="nav-link" href="/signup"><b>Sign Up</b></a>
        <a class="nav-link" href="/login"><b>Log In</b></a>
        <% } %> <% if (currUser) { %>
        <a class="nav-link" href="/logout"><b>Log Out</b></a>
        <% } %>
      </div>
    </div>
  </div>
</nav>
