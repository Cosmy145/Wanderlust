<% layout('/layouts/boilerplate') %>
<style>
  .filters {
    display: flex;
    justify-content: center;
    gap: 30px;
    /* width: 75vw; */
    /* margin: auto; */
    /* border: 2px solid black; */
    font-size: 0.9rem;
  }
  .filter {
    text-align: center;
    opacity: 0.6;
  }
  .filter>p{
    margin-bottom: 0px !important;
  }
  .filter:hover {
    opacity: 1;
    cursor: pointer;
  }
  .header {
    display: flex;
    justify-content: space-around;
    font-size: 0.9rem;
    /* align-items: flex-end; */
  }
  .form-switch {
    /* width: 280px; */
    border: 2px solid rgba(0, 0, 0, 0.318);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-direction: row-reverse;
    opacity: 0.7;
    cursor: pointer;
    border-radius: 20px;
    padding: 10px !important;
    padding-right: 2.7rem !important;
  }
  .tax-info {
    display: none;
    /* font-size: 0.1rem; */
  }
  .form-check-label{
    font-size: 1rem;
    margin-right: 10px;
  }
</style>
<body> 
