  <div class="main d-flex flex-wrap gap-5 justify-content-center">
    <% for( let listing of listings) { %>
    <a
      href="/listings/<%= listing._id %>"
      class="link-underline link-underline-opacity-0"
    >
      <div class="card border-0" style="width: 25rem; height: 35rem">
        <img
          src="<%- listing.image.url %>"
          class="card-img-top p-2 rounded-4"
          alt="listing image"
        />
        <div class="card-body">
          <h5 class="card-title"><%- listing.title %></h5>
          <p class="card-text"><%= listing.description %></p>
          <p class="price">
            &#8377;<%= (listing.price != null) ?
            listing.price.toLocaleString("en-IN") : "Price not available"
            %>/night
            <i class="tax-info">&nbsp; + 18% GST</i>
          </p>
        </div>
      </div>
    </a>
    <% } %>
  </div>
  <script>
    let taxSwitch = document.getElementById("flexSwitchCheckReverse");
    taxSwitch.addEventListener("click", () => {
      let taxInfo = document.getElementsByClassName("tax-info");
      let formSwitch = document.getElementsByClassName("form-switch");
      for (info of taxInfo) {
        if (info.style.display != "inline") {
          info.style.display = "inline";
          formSwitch[0].style.opacity = 1;
        } else {
          info.style.display = "none";
          formSwitch[0].style.opacity = 0.7;
        }
      }
    });
  </script>
</body>
